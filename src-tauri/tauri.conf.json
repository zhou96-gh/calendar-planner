{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "桌面日历",
  "version": "2.0.20",
  "identifier": "com.desktopcalendartodo.app",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../web-dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "桌面日历",
        "width": 680,
        "height": 700,
        "minWidth": 680,
        "minHeight": 700,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https://raw.githubusercontent.com https://cdn.jsdelivr.net"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "mainBinaryName": "桌面日历"
}
